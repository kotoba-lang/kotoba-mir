;; Source-only aggregate. Not registered CI or native qualification evidence.
(ns kotoba.mir-canonical-cases
  {:kotoba/export [main large-main]}
  (:require [kotoba.mir-catalog-cases :as catalog]
            [kotoba.mir-flat-cases :as flat]
            [kotoba.mir-module-cases :as module]
            [kotoba.mir-table-cases :as table]
            [kotoba.mir-selection-cases :as selection]
            [kotoba.mir-schedule-cases :as schedule]
            [kotoba.mir-counted-cases :as counted] [kotoba.mir-allocator-cases :as allocator]))

(defn main [] :i64
  (let [catalog-result (catalog/main)]
    (if (not= catalog-result 0) (+ 100 catalog-result)
      (let [flat-result (flat/main)]
        (if (not= flat-result 0) (+ 200 flat-result)
          (let [module-result (module/main)]
            (if (not= module-result 0) (+ 300 module-result)
              (let [table-result (table/main)]
                (if (not= table-result 0) (+ 600 table-result)
                  (let [selection-result (selection/main)]
                    (if (not= selection-result 0) (+ 700 selection-result)
                      (let [schedule-result (schedule/main)]
                        (if (not= schedule-result 0) (+ 800 schedule-result)
                          (let [counted-result (counted/main)]
                            (if (not= counted-result 0) (+ 1100 counted-result)
                              (let [allocator-result (allocator/main)]
                                (if (not= allocator-result 0) (+ 1300 allocator-result) 0)))))))))))))))))
(defn large-main [] :i64
  (let [module-result (module/large-main)]
    (if (not= module-result 0) (+ 400 module-result)
      (let [reentry-result (module/large-reentry-main)]
        (if (not= reentry-result 0) (+ 500 reentry-result)
          (let [table-result (table/large-main)]
            (if (not= table-result 0) (+ 900 table-result)
              (let [schedule-result (schedule/large-main)]
                (if (not= schedule-result 0) (+ 1000 schedule-result)
                  (let [counted-result (counted/large-main)]
                    (if (not= counted-result 0) (+ 1200 counted-result)
                      (let [allocator-result (allocator/large-main)]
                        (if (not= allocator-result 0) (+ 1400 allocator-result) 0)))))))))))))
