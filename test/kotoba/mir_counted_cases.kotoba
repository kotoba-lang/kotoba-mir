;; Uncompiled/unexecuted source cases. No runtime bulk charge is authorized.
(ns kotoba.mir-counted-cases
  {:kotoba/export [main large-main]}
  (:require [kotoba.gmir.node :as node] [kotoba.mir.catalog :as catalog]
            [kotoba.mir.counted :as counted] [kotoba.mir.validation :as validation]
            [kotoba.mir.outcome :as outcome] [kotoba.mir-module-cases :as check]))

(defn- at [value [:ref :gmir.node/value] index :i64] [:ref :gmir.node/value]
  (option-value-of [:option [:ref :gmir.node/value]] (node/child value index) (node/nil-value)))
(defn- kw [value :keyword] [:ref :gmir.node/value] (node/keyword-literal value))
(defn- sym [value :string] [:ref :gmir.node/value]
  (node/symbol-parts (option-none-of [:option [:ref :gmir.node/text]]) (node/string-text value)))
(defn- v [index :i64] [:ref :gmir.node/value]
  (node/keyword-parts (option-some-of [:option [:ref :gmir.node/text]] (node/string-text "kotoba.gmir.vreg"))
                      (node/string-text (string-from-i64 index))))
(defn- ins [op :keyword] [:ref :gmir.node/value] (node/put-key (node/empty-map) :mir/op (kw op)))
(defn- arg [dst :i64 index :i64] [:ref :gmir.node/value]
  (-> (ins :mir/argument) (node/put-key :mir/dst (v dst)) (node/put-key :mir/index (node/i64-value index))))
(defn- constant [dst :i64 value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :mir/constant) (node/put-key :mir/dst (v dst)) (node/put-key :mir/value value)))
(defn- binary [op :keyword dst :i64 left :i64 right :i64] [:ref :gmir.node/value]
  (-> (ins op) (node/put-key :mir/dst (v dst)) (node/put-key :mir/left (v left)) (node/put-key :mir/right (v right))))
(defn- ret [value :i64] [:ref :gmir.node/value] (node/put-key (ins :mir/return) :mir/value (v value)))
(defn- arguments [] [:ref :gmir.node/value] (-> (node/empty-vector) (node/append (v 4)) (node/append (v 5))))
(defn- tail [] [:ref :gmir.node/value]
  (-> (ins :mir/tail-call) (node/put-key :mir/callee (sym "counted")) (node/put-key :mir/arguments (arguments))))
(defn- fixture [extra [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [prefix (-> (node/empty-vector) (node/append (arg 0 0)) (node/append (arg 1 1))
                  (node/append (-> (ins :mir/branch-nonzero) (node/put-key :mir/test (v 0)) (node/put-key :mir/target (kw :test/body))))
                  (node/append (ret 1)) (node/append (node/put-key (ins :mir/label) :mir/id (kw :test/body))))
        body (loop [index 0 out prefix]
               (if (>= index (node/child-count extra)) out (recur (+ index 1) (node/append out (at extra index)))))
        code (-> body (node/append (constant 3 (node/i64-value 1))) (node/append (binary :mir/subtract 4 0 3))
                      (node/append (binary :mir/add 5 1 3)) (node/append (tail)))]
    (-> (node/empty-map) (node/put-key :mir/name (sym "counted")) (node/put-key :mir/arity (node/i64-value 2)) (node/put-key :mir/instructions code))))
(defn- replace [function [:ref :gmir.node/value] index :i64 value [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [code (node/key function :mir/instructions)
        changed (loop [cursor 0 out (node/empty-vector)]
                  (if (>= cursor (node/child-count code)) out
                    (recur (+ cursor 1) (node/append out (if (= cursor index) value (at code cursor))))))]
    (node/put-key function :mir/instructions changed)))
(defn- expected [index :i64] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :counter-parameter (node/i64-value index))
      (node/put-key :runtime-domain (kw :nonnegative-i64)) (node/put-key :charge (kw :entry-plus-exact-self-recur-count))))
(defn- plan=? [function [:ref :gmir.node/value] index :i64] :bool
  (let [result (counted/counted-self-recur-plan function)]
    (and (option-some?-of [:option [:ref :gmir.node/value]] result)
         (check/same-value? (option-value-of [:option [:ref :gmir.node/value]] result (node/nil-value)) (expected index)))))
(defn- refused? [function [:ref :gmir.node/value]] :bool
  (not (option-some?-of [:option [:ref :gmir.node/value]] (counted/counted-self-recur-plan function))))
(defn- extra [instruction [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (fixture (node/append (node/empty-vector) instruction)))
(defn- quotient [divisor [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (ins :mir/quotient-constant) (node/put-key :mir/dst (v 6)) (node/put-key :mir/left (v 1)) (node/put-key :mir/divisor divisor)))
(defn- literals? [] :bool
  (let [base (fixture (node/empty-vector)) one (node/integer-value (node/string-text "1"))
        two (node/integer-value (node/string-text "2")) minus-one (node/integer-value (node/string-text "-1"))
        minimum (node/integer-value (node/string-text "-9223372036854775808"))]
    (and (plan=? base 0) (plan=? (replace base 5 (constant 3 one)) 0)
         (plan=? (extra (quotient two)) 0) (plan=? (extra (quotient minimum)) 0)
         (refused? (extra (quotient minus-one))) (refused? (extra (quotient (node/i64-value 0))))
         (refused? (extra (quotient (node/integer-value (node/string-text "9223372036854775808")))))
         (refused? (extra (quotient (node/f64-bits-value 0x4000000000000000))))
         (refused? (replace base 5 (constant 3 (node/i64-value 2))))
         (refused? (replace base 5 (constant 3 (node/i64-value -1))))
         (refused? (replace base 7 (constant 3 (node/i64-value 2))))
         (plan=? (replace base 7 (constant 3 one)) 0))))
(defn- structural? [] :bool
  (let [base (fixture (node/empty-vector)) code (node/key base :mir/instructions)
        swapped (replace (replace base 0 (arg 1 1)) 1 (arg 0 0))
        second (-> base (replace 2 (node/put-key (at code 2) :mir/test (v 1)))
                       (replace 6 (binary :mir/subtract 4 1 3))
                       (replace 8 (node/put-key (tail) :mir/arguments (-> (node/empty-vector) (node/append (v 5)) (node/append (v 4))))))
        branch (at code 2) tail-instruction (at code 8)]
    (and (plan=? swapped 0) (plan=? second 1)
         (plan=? (node/put-key base :mir/arity (node/integer-value (node/string-text "2"))) 0)
         (plan=? (replace base 1 (node/put-key (arg 1 1) :mir/index (node/integer-value (node/string-text "1")))) 0)
         (refused? (node/put-key base :mir/name (kw :counted)))
         (refused? (node/put-key base :mir/arity (node/f64-bits-value 0x4000000000000000)))
         (refused? (node/put-key base :mir/arity (node/i64-value -1)))
         (refused? (replace base 1 (arg 1 0))) (refused? (replace base 1 (arg 1 2)))
         (refused? (replace base 2 (node/put-key branch :mir/op (kw :mir/branch-zero))))
         (refused? (replace base 2 (node/put-key branch :mir/target (kw :test/other))))
         (refused? (replace base 2 (node/put-key branch :mir/test (v 7))))
         (refused? (replace base 3 (at code 4)))
         (refused? (replace base 8 (node/put-key tail-instruction :mir/callee (sym "other"))))
         (refused? (replace base 8 (node/put-key tail-instruction :mir/arguments (node/append (node/empty-vector) (v 4)))))
         (refused? (replace base 8 (node/put-key tail-instruction :mir/arguments (-> (node/empty-vector) (node/append (v 1)) (node/append (v 5))))))
         (refused? (replace base 6 (binary :mir/add 4 0 3)))
         (refused? (replace base 6 (binary :mir/subtract 4 1 3)))
         (refused? (extra branch)) (refused? (extra tail-instruction)) (refused? (extra (at code 4)))
         (refused? (node/put-key base :mir/instructions (node/append code (constant 6 (node/i64-value 7))))))))
(defn- closed-operations? [] :bool
  ;; Independent literal predicate over every catalog operation. These direct
  ;; analysis cases deliberately test the op allow-list without validating an
  ;; invented malformed instruction as a selected program.
  (let [rows (catalog/instruction-keysets)]
    (loop [index 0]
      (if (>= index (vector-count rows)) true
        (let [op (catalog/shape-operation (typed-list-nth [:list [:ref :mir.catalog/shape]] rows index))
              allowed (case op :mir/constant true :mir/add true :mir/subtract true :mir/multiply true
                        :mir/multiply-add true :mir/multiply-subtract true :mir/bit-and true :mir/bit-or true :mir/bit-xor true
                        :mir/shift-left true :mir/shift-right-signed true :mir/shift-right-unsigned true
                        :mir/equal true :mir/less-than true :mir/greater-than true :mir/less-or-equal true :mir/greater-or-equal true :mir/move true false)
              function (extra (ins op))]
          (if (if allowed (plan=? function 0) (refused? function)) (recur (+ index 1)) false))))))
(defn- helper [extra-instruction [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (let [start (node/append (node/empty-vector) (arg 6 0))
        body (if (= (node/kind extra-instruction) :nil) start (node/append start extra-instruction))]
    (-> (node/empty-map) (node/put-key :mir/name (sym "helper")) (node/put-key :mir/arity (node/i64-value 1))
        (node/put-key :mir/instructions (node/append body (ret 6))))))
(defn- call [callee :string] [:ref :gmir.node/value]
  (-> (ins :mir/call) (node/put-key :mir/dst (v 7)) (node/put-key :mir/callee (sym callee))
      (node/put-key :mir/arguments (node/append (node/empty-vector) (v 1)))))
(defn- module [target :keyword callee [:ref :gmir.node/value]] [:ref :gmir.node/value]
  (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 3)) (node/put-key :mir/target (kw target))
      (node/put-key :mir/registers (kw :virtual)) (node/put-key :mir/entry (sym "counted"))
      (node/put-key :mir/functions (-> (node/empty-vector) (node/append (extra (call "helper"))) (node/append callee)))))
(defn- module-plan? [target :keyword callee [:ref :gmir.node/value] admit :bool] :bool
  (let [result (counted/counted-self-recur-plans (module target callee))
        plans (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value))
        expected-map (if admit (-> (node/empty-map) (node/append (sym "counted")) (node/append (expected 0))) (node/empty-map))]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result) (check/same-value? plans expected-map))))
(defn- module-cases? [target :keyword] :bool
  (let [plain (helper (node/nil-value))
        safe (helper (-> (quotient (node/i64-value 2)) (node/put-key :mir/dst (v 7)) (node/put-key :mir/left (v 6))))
        unsafe (helper (-> (quotient (node/i64-value -1)) (node/put-key :mir/dst (v 7)) (node/put-key :mir/left (v 6))))
        cyclic (helper (node/put-key (call "helper") :mir/arguments (node/append (node/empty-vector) (v 6))))
        effectful (helper (-> (ins :mir/capability-call) (node/put-key :mir/dst (v 7)) (node/put-key :mir/capability (node/i64-value 0))
                             (node/put-key :mir/kind (kw :i64)) (node/put-key :mir/context-offset (node/i64-value 48))
                             (node/put-key :mir/arguments (node/append (node/empty-vector) (v 6)))))
        branching (node/put-key plain :mir/instructions
                    (-> (node/empty-vector) (node/append (arg 6 0))
                        (node/append (-> (ins :mir/branch-zero) (node/put-key :mir/test (v 6)) (node/put-key :mir/target (kw :test/helper-zero))))
                        (node/append (ret 6)) (node/append (node/put-key (ins :mir/label) :mir/id (kw :test/helper-zero))) (node/append (ret 6))))
        invalid (node/put-key (module target plain) :mir/entry (sym "missing"))
        checked (validation/validate! invalid) analyzed (counted/counted-self-recur-plans invalid)
        a (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] checked (outcome/refusal :unexpected-success invalid))
        b (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] analyzed (outcome/refusal :unexpected-success invalid))]
    (and (refused? (extra (call "helper"))) (module-plan? target plain true)
         (module-plan? target safe true) (module-plan? target unsafe false) (module-plan? target cyclic false)
         (module-plan? target effectful false) (module-plan? target branching false)
         (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] analyzed))
         (= (outcome/phase a) (outcome/phase b)) (= (outcome/problem a) (outcome/problem b))
         (string=? (outcome/message a) (outcome/message b)) (check/same-value? (outcome/instruction a) (outcome/instruction b)))))
(defn- flat-guard? [] :bool
  (let [program (-> (node/empty-map) (node/put-key :mir/version (node/i64-value 2))
                    (node/put-key :mir/target (kw :x86-64)) (node/put-key :mir/registers (kw :virtual))
                    (node/put-key :mir/instructions (-> (node/empty-vector) (node/append (constant 0 (node/i64-value 1))) (node/append (ret 0)))))
        checked (validation/validate! program) result (counted/counted-self-recur-plans program)
        error (result-error-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (outcome/refusal :unexpected-success program))]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] checked)
         (not (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result))
         (= (outcome/phase error) :mir) (= (outcome/problem error) :bulk-fuel-analysis-requires-selected-virtual-module)
         (string=? (outcome/message error) "MIR rejected: bulk-fuel-analysis-requires-selected-virtual-module")
         (check/same-value? (outcome/instruction error) program))))
(defn- many-plans? [] :bool
  (let [base (fixture (node/empty-vector))
        functions (loop [index 0 out (node/append (node/empty-vector) base)]
                    (if (>= index 40) out
                      (let [name (sym (string-concat "counted" (string-from-i64 index)))
                            value (-> base (node/put-key :mir/name name) (replace 8 (node/put-key (tail) :mir/callee name)))]
                        (recur (+ index 1) (node/append out value)))))
        program (-> (module :x86-64 (helper (node/nil-value))) (node/put-key :mir/functions functions))
        result (counted/counted-self-recur-plans program)
        plans (result-value-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result (node/nil-value))]
    (and (result-ok?-of [:result [:ref :gmir.node/value] [:ref :mir/refusal]] result) (= (node/child-count plans) 82)
         (loop [index 0]
           (if (>= index 41) true
             (if (and (node/same-name? (at plans (* index 2)) (node/key (at functions index) :mir/name))
                      (check/same-value? (at plans (+ (* index 2) 1)) (expected 0))) (recur (+ index 1)) false))))))
(defn main [] :i64
  (cond (not (literals?)) 1 (not (structural?)) 2 (not (closed-operations?)) 3
        (not (module-cases? :x86-64)) 4 (not (module-cases? :aarch64)) 5
        (not (flat-guard?)) 6 (not (many-plans?)) 7 :else 0))
(defn large-main [] :i64
  (let [extra-code (loop [index 0 out (node/empty-vector)]
                     (if (>= index 16385) out
                       (recur (+ index 1) (node/append out (constant (+ index 8) (node/i64-value index))))))]
    (if (plan=? (fixture extra-code) 0) 0 1)))
